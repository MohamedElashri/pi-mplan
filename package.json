{
  "name": "pi-mplan",
  "version": "0.2.4",
  "packageManager": "pnpm@11.2.2",
  "description": "Plan + AGENTS.md generator extension for Pi. Automates creating plan.md and AGENTS.md for your projects from your own templates",
  "license": "MIT",
  "author": "Mohamed Elashri",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CONFIG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "pnpm check && pnpm test && pnpm build",
    "release:check": "pnpm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "pi-agent",
    "pi-mplan",
    "plan",
    "agencies",
    "agents-md",
    "planning",
    "ai",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedElashri/pi-mplan.git"
  },
  "homepage": "https://github.com/MohamedElashri/pi-mplan#readme",
  "bugs": {
    "url": "https://github.com/MohamedElashri/pi-mplan/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
